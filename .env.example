# Fictional placeholder only. Export these variables in your shell or IDE.
# Spring Boot does not automatically load this file or .env.
AI_PROVIDER=openai
# Required when AI_PROVIDER=openai, or when RAG_ENABLED=true and RAG_EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=not-a-real-api-key
OPENAI_MODEL=gpt-6-luna
AI_PROMPT_VERSION=incident-analysis-v2
AI_MAX_OUTPUT_TOKENS=1000
AI_TIMEOUT=20s
OLLAMA_MODEL=qwen3:14b
OLLAMA_BASE_URL=http://localhost:11434

# Embedding provider is independent of AI_PROVIDER.
RAG_ENABLED=false
RAG_EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_DIMENSIONS=768
RAG_EMBEDDING_TIMEOUT=20s
# OPENAI_API_KEY above is also required when RAG is enabled with OpenAI embeddings.
# OLLAMA_BASE_URL above is shared with the Ollama embedding client.
